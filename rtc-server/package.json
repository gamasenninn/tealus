{
  "name": "tealus-rtc-server",
  "version": "0.1.1",
  "engines": {
    "node": ">=22.6.0"
  },
  "description": "Tealus RTC Server — mediasoup SFU for voice/video calls and transceiver",
  "license": "MIT",
  "main": "server.mts",
  "scripts": {
    "build": "esbuild src/client.ts --bundle --outfile=public/bundle.js --format=iife --platform=browser",
    "postinstall": "npm run build",
    "start": "node server.mts",
    "dev": "npm run build && node server.mts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.0",
    "express": "^5.2.1",
    "form-data": "^4.0.5",
    "jsonwebtoken": "^9.0.3",
    "mediasoup": "^3.19.19",
    "mediasoup-client": "^3.18.7",
    "socket.io-client": "^4.8.3",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2"
  }
}
