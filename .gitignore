# Dependencies
node_modules/

# Environment variables
.env
.env.local
.env.test
scripts/.env.trx

# MCP / Agent server secrets
agent-server/mcp_config.json
agent-server/logs/
# ★ .mcp.json は Claude Code の MCP 定義。tealus MCP の env に平文の
#   TEALUS_USER_ID / TEALUS_PASSWORD が入るため追跡しない (#392)。
#   ★ この repo は PUBLIC。gitignore が無いと `git add -A` 一発で資格情報が公開される。
#   兄弟プロジェクト (tealus-apps / tealus-kairos 等) では `.mcp.json.example` を
#   コミットして実体は各自が置く形をとっている。
.mcp.json

# Voice transcription guideline (実運用版、example はコミット)
# ★ 派生も必ず含める: enriched 版は description に個人名+所属+雇用形態を持ち、
#   TRANSCRIPTION_GUIDELINE_PATH で本番が実際に読んでいる (2026-08-11 に未追跡で発見)。
#   glob にしてあるのは、次の派生 (.enriched2 等) を作ったときに漏れないようにするため。
server/config/transcription_guideline*.json
!server/config/transcription_guideline.example.json
server/config/mining_report.json
# #348 (a): 辞書テーブル由来の local vocab 契約 (auto 生成、refreshVocabFromTable が発行)
server/config/dictionary.local.ttl

# LINE Bridge Phase 2.3 (= 6/6 Day 21 確立、2 file 案): example はコミット、実運用 file は ignored
server/config/line-groups.json
server/config/line-group-mappings.json
# LINE Bridge #309 案A: 送信者名 cache (= LINE 表示名 = 個人情報、runtime 生成)
server/config/line-members.json
# #382 ルームトリガー: room_id / user id という端末固有の値を持つ。example はコミットする
server/config/room-triggers.json

# Marp 生成物 (markdown source からビルド可能、commit 不要)
docs/presentation/*.html
docs/presentation/*.pdf
docs/presentation/*.pptx

